@startuml
!theme plain
actor Staff
participant "API Gateway" as Gateway
participant "Ticket Service" as TicketService
database "Ticket DB" as TicketDB

Staff -> Gateway : POST /api/tickets/{ticketCode}/scan?gate=X&deviceId=Y
activate Gateway
Gateway -> TicketService : scanTicket(ticketCode, gate, deviceId)
activate TicketService
TicketService -> TicketDB : Read Ticket by ticketCode
activate TicketDB
TicketDB --> TicketService : Ticket Details
deactivate TicketDB
TicketService -> TicketService : Validate Ticket Status (e.g., ISSUED)
TicketService -> TicketService : Check for duplicate scan
alt Ticket is Valid and not SCANNED
    TicketService -> TicketDB : Update Ticket Status to SCANNED
    TicketService -> TicketDB : Create CheckInLog(ticket, event, user, time, gate, deviceId)
    activate TicketDB
    TicketDB --> TicketService : Confirmation
    deactivate TicketDB
    TicketService --> Gateway : TicketResponse (SCANNED)
    Gateway --> Staff : HTTP 200 OK / TicketResponse
else Ticket is already SCANNED or REFUNDED/INVALID
    TicketService --> Gateway : Error: Ticket already scanned / Invalid / Refunded
    Gateway --> Staff : HTTP 500 Internal Server Error (or 400 Bad Request if validation is before 500)
end
deactivate TicketService
deactivate Gateway
@enduml