@startuml
!theme plain
hide circle
skinparam linetype ortho

class Order {
    Long id
    UUID userId
    Long eventId
    BigDecimal totalAmount
    String currency
    String discountCode
    String paymentMethod
    OrderStatus status
    LocalDateTime createdAt
    LocalDateTime updatedAt
}

class OrderItem {
    Long id
    Order order
    Long ticketTypeId
    BigDecimal price
}

class Ticket {
    Long id
    OrderItem orderItem
    Long seatId
    String ticketCode
    String attendeeName
    String attendeeEmail
    TicketStatus status
    LocalDateTime createdAt
    LocalDateTime updatedAt
}

class PaymentInfo {
    Long id
    Order order
    String method
    String transactionId
    BigDecimal amount
    PaymentStatus status
    LocalDateTime paidAt
}

class Reservation {
    Long id
    UUID userId
    Long eventId
    Long ticketTypeId
    Long seatId
    Integer quantity
    LocalDateTime expireAt
    ReservationStatus status
}

class CheckInLog {
    Long id
    Ticket ticket
    Long eventId
    UUID userId
    LocalDateTime checkInTime
    String gate
    String deviceId
}

Order "1" *-- "1..*" OrderItem
Order "1" -- "0..1" PaymentInfo
OrderItem "1" *-- "1..*" Ticket
Ticket "1" -- "0..*" CheckInLog

enum OrderStatus {
    PENDING
    PAID
    CANCELLED
    REFUNDED
}

enum TicketStatus {
    ISSUED
    SCANNED
    TRANSFERRED
    REFUNDED
}

enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
}

enum ReservationStatus {
    PENDING
    CONFIRMED
    EXPIRED
    CANCELLED
}
@enduml